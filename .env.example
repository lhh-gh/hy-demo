APP_NAME=skeleton
APP_ENV=dev

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

# 静态阿里云发送器的可选配置；生产动态路由从数据库读取渠道凭据、签名和模板。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 动态短信凭据加密密钥：Base64 编码的 32 字节随机值。
# 生成命令：openssl rand -base64 32
# 保存于部署环境的密钥管理系统或本地 .env，所有 Worker/实例必须使用同一密钥。
# 不提交真实密钥；妥善备份，直接更换会导致已有数据库密文无法解密。
SMS_CREDENTIALS_KEY=
